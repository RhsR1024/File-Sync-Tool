{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "file-sync-tool",
  "version": "1.1.2",
  "identifier": "com.filesync.tool",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "File Sync Tool",
        "width": 800,
        "height": 600,
        "visible": false,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/**/clipboard_images/**", "$APPDATA/**/clipboard_icons/**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "resources": {
      "../scripts/restore-win-v.ps1": "scripts/restore-win-v.ps1"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
